# Copy this file to .env for local development. Do not commit real secrets.
SECRET_KEY=replace-this-with-a-random-secret
POWERBI_EMBED_URL=

# --- API del ESP32 y monitoreo en vivo (solo en el equipo local; no configurar en Render) ---
# ENABLE_DEVICE_API=1
# DEVICE_API_KEY=cambia-esta-clave-larga-y-aleatoria
# DEVICE_RATE_LIMIT=120
# Opcional: guardar las lecturas reales en AgroSmartDB (autenticación de Windows, sin contraseña)
# AGROSMART_DB_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=AgroSmartDB;Trusted_Connection=yes;TrustServerCertificate=yes
